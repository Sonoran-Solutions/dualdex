<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud backup is allowed only when the transport supports encryption. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="saves_v2/" />
        <include domain="file" path="saves/" />
        <include domain="file" path="saves_fallback/" />
        <include domain="sharedpref" path="dualdex_legacy_catalog.xml" />
    </cloud-backup>
    <!-- Device transfer has its own allowlist; it does not inherit cloud rules. -->
    <device-transfer>
        <include domain="file" path="saves_v2/" />
        <include domain="file" path="saves/" />
        <include domain="file" path="saves_fallback/" />
        <include domain="sharedpref" path="dualdex_legacy_catalog.xml" />
    </device-transfer>
</data-extraction-rules>
