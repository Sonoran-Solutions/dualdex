# H&S 2.0.5 trainer battle classification scenario
#
# Verifies that entering a trainer battle with a 2-member enemy party correctly classifies
# as TRAINER_SINGLE and resolves the initial opponent through gBattlerPartyIndexes.
#
# Required save state: player party count >= 2, trainer with >= 2 Pokémon reachable.
# Generated by: make-save.sh
#
# Invariants checked per frame while ACTIVE:
#   1. resolved_enemy_slot < gEnemyPartyCount
#   2. resolved_enemy_slot == gBattlerPartyIndexes[resolved_enemy_battler]
#   3. resolved_player_slot == gBattlerPartyIndexes[resolved_player_battler]
#   4. No unresolved state becomes slot 0
#   5. No stale previous slot survives a completed transition

scenario: trainer_battle
save_state: auto  # loaded from make-save.sh output

phase: enter_trainer_battle
  assert-lifecycle ACTIVE
  assert-battle-kind trainer
  assert-gBattlersCount 2
  assert-enemy-party-count >= 2
  assert-in-battle-flag true
  record initial_enemy_battler
  record initial_enemy_slot
  record initial_enemy_party_count
  record initial_enemy_species
  record initial_enemy_hp
  record initial_player_slot
